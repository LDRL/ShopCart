NODE_ENV=development
PORT=3000
SQL_DATABASE=your_database
SQL_USER=your_user
SQL_PASSWORD=your_password
SQL_HOST=localhost
SQL_PORT=1433

JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

FRONTEND_URL=http://localhost:5173

# IVA incluido en los precios publicados (porcentaje). Puede cambiar (ej. 5).
IVA_PORCENTAJE=12

# Cookies (refresh token en HttpOnly).
# En produccion: COOKIE_SECURE=true y COOKIE_SAME_SITE=lax (mismo site) o none (cross-site, exige HTTPS).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
